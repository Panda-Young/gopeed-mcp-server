# Gopeed API 地址。
# 默认 http://127.0.0.1:7766/api/v1（端口 7766 为固定端口）。
# 若 Gopeed 使用随机端口，可留空端口部分（如 http://127.0.0.1/api/v1），
# server 会自动发现 Gopeed 实际端口。
GOPEED_API_URL=http://127.0.0.1:7766/api/v1

# Gopeed API 令牌（可选，仅当 Gopeed 配置了访问令牌时填写）
# GOPEED_API_TOKEN=your_token_here

# HTTP 请求超时时间（秒，默认 10）
# GOPEED_TIMEOUT=10
